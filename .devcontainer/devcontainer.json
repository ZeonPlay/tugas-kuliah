{
  "name": "Tugas Kuliah Web",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "web/README.md"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "updateContentCommand": "npm ci --prefix web",
  "postAttachCommand": {
    "server": "npm run dev --prefix web -- --host 0.0.0.0"
  },
  "portsAttributes": {
    "5173": {
      "label": "Tugas Kuliah Web",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    5173
  ]
}
